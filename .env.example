# ─────────────────────────────────────────────────────────────────────────────
# observe-platform — environment configuration
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# Port the platform API listens on (Flutter default: 8090)
PORT=8090

# ── Target system URLs ────────────────────────────────────────────────────────
# Arthur trading-bot REST API
ARTHUR_API_URL=http://localhost:8420

# Jaeger UI/Query API (for trace data)
JAEGER_API_URL=http://localhost:16686

# ── AI (Google Gemini) ────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── API Key Management ────────────────────────────────────────────────────────
# Secret required to call POST/GET/DELETE /admin/keys endpoints.
# Leave empty to run in open dev mode (no admin auth).
ADMIN_SECRET=change_me_in_production

# Optional: seed one default API key at startup so Flutter works immediately.
# Generate a new one with:  openssl rand -hex 24  then prefix with obs_
DEFAULT_API_KEY=obs_demo_replace_this_with_real_key
DEFAULT_KEY_NAME=Default Dev Key

# Path to the JSON file where API keys are persisted across restarts.
# Leave as default or set to an absolute path.
API_KEYS_FILE=api_keys.json

# ── OpenTelemetry Collector ───────────────────────────────────────────────────
# gRPC endpoint for the platform to export its own traces.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
